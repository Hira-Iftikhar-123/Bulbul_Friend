# Railway Frontend Environment Configuration

# Backend API URL (Set this to your Railway backend service URL)
REACT_APP_API_URL=https://your-backend-service.up.railway.app

# Environment
NODE_ENV=production
PORT=3000

# Optional: Analytics and monitoring
REACT_APP_GA_TRACKING_ID=your_ga_tracking_id_here
REACT_APP_SENTRY_DSN=your_sentry_dsn_here
