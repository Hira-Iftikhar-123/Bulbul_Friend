{
  "name": "bulbul-friend-frontend",
  "version": "1.0.0",
  "description": "AI-powered Arabic-speaking companion frontend",
  "private": true,
  "dependencies": {
    "axios": "^1.4.0",
    "cross-env": "^7.0.3",
    "csstype": "^3.1.3",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.3.0",
    "serve": "^14.2.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "start": "npm run build && npx serve -s build -l 3000",
    "start-prod": "npm run build && npx serve -s build -l $PORT",
    "dev": "npx webpack serve --mode development",
    "dev-prod": "npx webpack serve --mode production --host 0.0.0.0 --port 3000",
    "build": "npx webpack --mode production",
    "build-prod": "npx webpack --mode production",
    "serve": "npx serve -s build -l 3000",
    "railway-build": "npm install --production=false --no-audit --no-fund && npm run build",
    "docker-build": "npx webpack --mode production"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@types/react": "^19.1.10",
    "babel-loader": "^9.1.0",
    "copy-webpack-plugin": "13.0.1",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.88.0",
    "webpack-dev-server": "^4.15.0"
  }
}
